# Server Port (Render sets PORT automatically, locally uses 5000)
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas for cloud, localhost for local dev)
# Example for Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jansathi?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.givehij.mongodb.net/JanSathi?retryWrites=true&w=majority

# JWT Secret for authenticating users & admins (use a long random string)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=30d

# Google Gemini API Key (for AI categorization & grievance analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (your deployed frontend URL on Render)
# e.g. https://jansathi.onrender.com or http://localhost:5173 for dev
FRONTEND_URL=https://your-frontend-subdomain.onrender.com
